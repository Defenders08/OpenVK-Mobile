{*  =========================================================
    @CanonicalListView.xml — упрощённый список БЕЗ layout.

    Отличие от @listView.xml: этот файл не наследует
    @layout.xml, поэтому его подключают внутрь уже готовой
    страницы. Блоки те же: tabs, link, preview, name,
    description, customErrorMessage.
    ========================================================= *}

<div class="page">

    <div n:ifset="tabs" class="tabs">
        {include tabs}
    </div>

    <div class="list">
        {var $data = is_array($iterator) ? $iterator : iterator_to_array($iterator)}

        {if sizeof($data) > 0}

            <div class="list-item" n:foreach="$data as $dat">
                <div class="list-item-cover">
                    <a href="{include link, x => $dat}">{include preview, x => $dat}</a>
                </div>
                <div class="list-item-info">
                    <a href="{include link, x => $dat}"><b>{include name, x => $dat}</b></a>
                    <div>{include description, x => $dat}</div>
                </div>
            </div>

            {include "components/paginator.xml", conf => (object) [
                "page"    => $page,
                "count"   => $count,
                "amount"  => sizeof($data),
                "perPage" => $perPage ?? \OPENVK_DEFAULT_PER_PAGE,
                "atTop"   => false,
                "tidy"    => false
            ]}

        {else}
            {ifset customErrorMessage}
                {include customErrorMessage}
            {else}
                {include "components/nothing.xml"}
            {/ifset}
        {/if}
    </div>

</div>
