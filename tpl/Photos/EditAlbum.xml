{*  =========================================================
    EDIT ALBUM — редактирование альбома (/album{id}/edit).

    POST с полями name, desc, hash (CSRF).
    Ссылка удаления содержит CSRF-хеш — сохранять обязательно.
    ========================================================= *}

{extends "../@layout.xml"}

{block title}{_edit_album}{/block}

{block header}
    {$album->getName()}
{/block}

{block content}

    <div class="tabs">
        <div id="activetabs" class="tab">
            <a id="act_tab_a" href="/album{$album->getPrettyId()}/edit">{_edit_album}</a>
        </div>
        <div class="tab">
            <a href="/photos/upload?album={$album->getPrettyId()}">{_add_photos}</a>
        </div>
    </div>

    <form class="form" method="post" enctype="multipart/form-data">

        <div class="form-field">
            <label class="form-label" for="name">{_name}</label>
            <input class="form-input" id="name" type="text" name="name" value="{$album->getName()}" />
        </div>

        <div class="form-field">
            <label class="form-label" for="desc">{_description}</label>
            <textarea class="form-input" id="desc" name="desc">{$album->getDescription()}</textarea>
        </div>

        <input type="hidden" name="hash" value="{$csrfToken}" />

        <div class="form-actions">
            <input type="submit" class="button button-primary" name="submit" value="{_save}" />
        </div>

    </form>

    <hr />

    <p>
        {_you_can_also}
        <a href="/album{$album->getOwner() instanceof openvk\Web\Models\Entities\Club ? '-' : ''}{$album->getOwner()->getId()}_{$album->getId()}/delete?hash={rawurlencode($csrfToken)}">{_delete_album}</a>.
    </p>

{/block}
