{*  =========================================================
    LOGIN SECOND FACTOR — второй фактор при входе.

    $login и $password приходят с прошлого шага и уезжают
    обратно скрытыми полями. Их нельзя убирать: без них
    движок не знает, кого пускать.
    ========================================================= *}

{extends "../@layout.xml"}

{block title}{_log_in}{/block}
{block header}{_log_in}{/block}

{block content}
    <form class="form" method="POST" enctype="multipart/form-data">

        <h4>{_two_factor_authentication}</h4>
        <p>{_two_factor_authentication_login}</p>

        <div class="form-field">
            <label class="form-label" for="code">{_code}</label>
            <input class="form-input" id="code" type="number" name="code" autocomplete="off" required autofocus />
        </div>

        <input type="hidden" name="login" value="{$login}" />
        <input type="hidden" name="password" value="{$password}" />
        <input type="hidden" name="hash" value="{$csrfToken}" />

        <div class="form-actions">
            <input type="submit" value="{_log_in}" class="button button-primary" />
        </div>

    </form>
{/block}
