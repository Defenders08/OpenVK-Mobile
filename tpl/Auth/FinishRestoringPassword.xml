{*  =========================================================
    FINISH RESTORING PASSWORD — установка нового пароля.

    $is2faEnabled — включён ли у пользователя второй фактор.

    ВНИМАНИЕ: в оригинале оба поля называются name="password"
    (и новый пароль, и код 2FA). Мы это сохранили как есть —
    это поведение backend-а, а не вёрстки. Если менять, то в
    презентере, а не здесь.
    ========================================================= *}

{extends "../@layout.xml"}

{block title}{_access_recovery}{/block}
{block header}{_page_access_recovery}{/block}

{block content}
    <h4>{_access_recovery}</h4>
    <p>{_access_recovery_info_2}</p>

    <form class="form" method="POST" enctype="multipart/form-data">

        <div class="form-field">
            <label class="form-label" for="password">{_new_password}</label>
            <input class="form-input" id="password" type="password" name="password" required />
        </div>

        <div n:if="$is2faEnabled" class="form-field">
            <label class="form-label">{_"2fa_code_2"}</label>
            <input class="form-input" type="number" autocomplete="off" name="password" required />
        </div>

        <input type="hidden" name="hash" value="{$csrfToken}" />

        <div class="form-actions">
            <input type="submit" value="{_reset_password}" class="button button-primary" />
        </div>

    </form>
{/block}
