{*  =========================================================
    REGISTER — регистрация (/reg).

    $referer               — пригласивший пользователь (если есть);
    $emailWhitelistEnabled, $emailWhitelisted — ограничение
                             доменов почты.

    Обязательные поля формы: first_name, last_name, email,
    password, birthday, pronouns, confirmation, hash (CSRF).
    captcha_template() — штатная капча OpenVK, вставляется как
    готовый HTML.

    Регистрацию можно закрыть в конфиге инстанса — тогда
    показывается объяснение вместо формы.
    ========================================================= *}

{extends "../@layout.xml"}

{block title}{_registration}{/block}
{block header}{_registration}{/block}

{block headIncludes}
    {if !$referer}
        <meta name="description" content="{tr('register_meta_desc', \OPENVK_ROOT_CONF['openvk']['appearance']['name'])}" />
    {else}
        {var $refAvatar = $referer->getAvatarUrl()}
        <meta property="og:title" content="{tr('register_referer_meta_title', $referer->getFullName(), \OPENVK_ROOT_CONF['openvk']['appearance']['name'])}" />
        <meta property="og:image" content="{$refAvatar}" />
        <meta name="twitter:title" content="{tr('register_referer_meta_title', $referer->getFullName(), \OPENVK_ROOT_CONF['openvk']['appearance']['name'])}" />
        <meta name="twitter:image" content="{$refAvatar}" />
        <meta name="description" content="{tr('register_referer_meta_desc', $referer->getFullName(), \OPENVK_ROOT_CONF['openvk']['appearance']['name'])}" />
    {/if}
{/block}

{block content}

{if \OPENVK_ROOT_CONF['openvk']['preferences']['registration']['enable'] || $referer}

    <p n:if="!is_null($referer)">
        {tr("invites_you_to", $referer->getFullName(), \OPENVK_ROOT_CONF['openvk']['appearance']['name'])|noescape}
    </p>

    <div id="reg_block">

        <h2>{_registration}</h2>
        <p>
            <b>{php echo \OPENVK_ROOT_CONF['openvk']['appearance']['name']} {_registration_welcome_1}</b><br />
            {_registration_welcome_2}
        </p>

        <form class="form" method="POST" enctype="multipart/form-data">

            <h4>{_main}</h4>

            <div class="form-field">
                <label class="form-label" for="first_name">{_name}</label>
                <input class="form-input" id="first_name" type="text" name="first_name" required />
            </div>

            <div class="form-field">
                <label class="form-label" for="last_name">{_surname}</label>
                <input class="form-input" id="last_name" type="text" name="last_name" />
            </div>

            <div class="form-field">
                <label class="form-label" for="email">{_email}</label>
                <input class="form-input" id="email" type="email" name="email" required />
                {* Если включён белый список доменов — показываем какие. *}
                <small n:if="$emailWhitelistEnabled">{tr('email_whitelist_desc', $emailWhitelisted)}</small>
            </div>

            <div class="form-field">
                <label class="form-label" for="password">{_password}</label>
                <input class="form-input" id="password" type="password" name="password" required />
            </div>

            <h4>{_other_fields}</h4>

            <div class="form-field">
                <label class="form-label" for="birthday">{_birth_date}</label>
                <input class="form-input" id="birthday" type="date" name="birthday" max="{date('Y-m-d')}" />
            </div>

            <div class="form-field">
                <label class="form-label" for="pronouns">{_pronouns}</label>
                <select id="pronouns" name="pronouns" required>
                    <option value="male">{_male}</option>
                    <option value="female">{_female}</option>
                    <option value="neutral">{_neutral}</option>
                </select>
            </div>

            {* Капчу рисует сам движок. Условие из оригинала:
               если капча уже пройдена, блок не нужен. *}
            {if !(strpos(captcha_template(), 'verified'))}
                <div class="form-field">
                    <span class="form-label">CAPTCHA</span>
                    {captcha_template()|noescape}
                </div>
            {/if}

            <input type="hidden" name="hash" value="{$csrfToken}" />

            <div class="form-field" id="reg_checkbox">
                <label>
                    <input type="checkbox" required="true" name="confirmation" />
                    {_checkbox_in_registration|noescape}
                </label>
            </div>

            <div class="form-actions">
                <input type="submit" value="{_registration}" class="button button-primary" />
            </div>

        </form>
    </div>

{else}

    {* Регистрация закрыта администратором инстанса. *}
    <h4>{_registration_closed}</h4>
    <p>
        {_registration_disabled_info}
        {if \OPENVK_ROOT_CONF['openvk']['preferences']['registration']['disablingReason']}
            <br /><br />{_admin_banned_link_reason}:<br />
            <b>{php echo \OPENVK_ROOT_CONF['openvk']['preferences']['registration']['disablingReason']}</b>
        {/if}
    </p>

{/if}

{/block}
