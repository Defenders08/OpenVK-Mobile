{*  ---------------------------------------------------------
    ERROR — короткое сообщение «ничего нет» / «ошибка».

    $title       — необязательный заголовок;
    $description — текст сообщения.
    --------------------------------------------------------- *}

<div class="message">
    <b n:if="!empty($title)">{$title}</b>
    <p>{$description}</p>
</div>
