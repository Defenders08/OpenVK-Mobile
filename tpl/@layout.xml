{*  =========================================================
    @layout.xml — ГЛАВНЫЙ КАРКАС ТЕМЫ

    От этого файла наследуются почти все страницы OpenVK
    (`{extends "../@layout.xml"}`), поэтому его блоки трогать
    осторожно.

    Блоки, которые определяют страницы:
      title        — заголовок вкладки браузера;
      headIncludes — дополнительные теги в <head> (og:, twitter:);
      header       — «хлебные крошки» над контентом;
      content      — основное содержимое страницы;
      wrap         — ПОЛНАЯ замена области контента
                     (используется @listView.xml и User/Fave.xml);
      bodyScripts  — скрипты конкретной страницы.

    $parentModule, $instance_name, $csrfToken, $thisUser,
    $flashMessage, $theme, $isXmas, $isTimezoned, $userTainted,
    $backdrops, $ticketAnsweredCount, $helpdeskTicketNotAnsweredCount,
    $reportNotAnsweredCount, $newsText, $newsLink, $showBday,
    $bdayUsers, $bdayCount, $isBdayToday, $showUEvents, $uEvents,
    $uEventsCount, $atSearch, $disable_ajax — всё это реальные
    переменные, которые подставляет OpenVKPresenter. Не выдумывайте
    свои и не удаляйте существующие.
    ========================================================= *}

{define header}{/define}
{capture $pageTitle}{ifset title}{include title}{/ifset}{/capture}

{*  Страница может рендериться внутри другого модуля Chandler.
    Тогда никакой <html> не нужен — только содержимое.
    Эта проверка есть в оригинале, удалять её нельзя:
    без неё ломаются встраиваемые страницы. *}
{if !isset($parentModule) || substr($parentModule, 0, 21) === 'libchandler:absolute.'}
<!DOCTYPE html>
<html>

<head>

    {* =====================================================
       META
       ===================================================== *}

    <title>{ifset title}{$pageTitle} - {/ifset}{$instance_name}</title>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
    <meta name="application-name" content="{$instance_name}" />

    {* CSRF-токен. Штатный JS OpenVK читает его из этого мета-тега
       для AJAX-запросов. НЕ УДАЛЯТЬ. *}
    <meta n:ifset="$csrfToken" name="csrf" value="{$csrfToken}" />

    <link rel="shortcut icon" href="/assets/packages/static/openvk/img/icon.ico" />

    <meta property="og:site_name" content="{$instance_name}" />
    <meta name="twitter:card" content="summary" />

    {* =====================================================
       JS OPENVK (верхняя часть)

       Это библиотеки и ядро движка. Всё это нужно штатным
       скриптам OpenVK, которые подключаются внизу <body>.
       Если что-то отсюда убрать — сломаются лайки,
       комментарии, плеер, загрузка фото и модальные окна.
       ===================================================== *}

    <script src="/language/{php echo getLanguage()}.js" crossorigin="anonymous"></script>

    {script "js/node_modules/jquery/dist/jquery.min.js"}
    {script "js/node_modules/jquery-ui/dist/jquery-ui.min.js"}
    {script "js/node_modules/umbrellajs/umbrella.min.js"}
    {script "js/l10n.js"}
    {script "js/openvk.cls.js"}
    {script "js/utils.js"}
    {script "js/node_modules/dashjs/dist/dash.all.min.js"}
    <script src="/assets/packages/static/openvk/js/node_modules/cropperjs/dist/cropper.js" type="module"></script>
    {script "js/node_modules/@popperjs/core/dist/umd/popper.min.js"}
    {script "js/node_modules/tippy.js/dist/tippy-bundle.umd.min.js"}
    {script "js/node_modules/handlebars/dist/handlebars.min.js"}
    {script "js/node_modules/react/dist/react-with-addons.min.js"}
    {script "js/node_modules/react-dom/dist/react-dom.min.js"}
    {script "js/vnd_literallycanvas.js"}

    {* Определение часового пояса. Отрабатывает один раз. *}
    {if $isTimezoned == NULL}
        {script "js/timezone.js"}
    {/if}

    {* =====================================================
       CSS

       Стили сторонних виджетов OpenVK (обрезка аватара,
       подсказки, карта) оставлены: без них соответствующие
       окна выглядят сломанными.
       Стили самой темы подключает _includeCSS.xml.
       ===================================================== *}

    {css "js/node_modules/cropperjs/dist/cropper.css"}
    {css "js/node_modules/tippy.js/dist/backdrop.css"}
