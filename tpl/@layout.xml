<script>
/* ================================================================
   JS ТЕМЫ: только интерфейс темы и мост к штатному OpenVK.

   Вложения НЕ загружаются этим кодом вручную.
   Мы передаём клик штатным элементам OpenVK из textArea.xml:
   __photoAttachment, __videoAttachment, __audioAttachment,
   __documentAttachment, __geoAttacher, __sourceAttacher.
   Так OpenVK сам создаёт attachment и обновляет hidden-поля формы.
   ================================================================ */

function toggleMenu() {
    document.body.classList.toggle('menu-open');
}

var currentAttachTarget = 'profile';

function openActionSheet() {}
function closeActionSheet() {}

/*
 * Находит штатную кнопку/ссылку OpenVK и нажимает её.
 * В некоторых шаблонах один и тот же id может присутствовать
 * несколько раз, поэтому сначала ищем элемент в нужном composer-е,
 * затем среди видимых элементов.
 */
function triggerOpenVKAttachment(type) {
    closeActionSheet();

    var selector = '[id="' + type + '"]';
    var candidates = Array.prototype.slice.call(document.querySelectorAll(selector));

    if (type === 'poll') {
        var pollCandidates = Array.prototype.slice.call(
            document.querySelectorAll('a[onclick*="initPoll"]')
        );
        candidates = pollCandidates;
    }

    if (!candidates.length) {
        if (typeof showToast === 'function') {
            showToast('Этот тип вложения недоступен на этой странице');
        }
        return false;
    }

    /*
     * Если есть несколько composer-ов, предпочитаем видимый.
     * Это важно для комментариев и постов, когда оба элемента
     * могут находиться в DOM одновременно.
     */
    var target = candidates.find(function (element) {
        var style = window.getComputedStyle(element);
        return style.display !== 'none' &&
               style.visibility !== 'hidden' &&
               element.offsetParent !== null;
    }) || candidates[0];

    target.click();
    return false;
}

/* Старое имя оставляем как совместимый алиас для кнопок темы. */
function attachMedia(type) {
    var map = {
        'Фотография': '__photoAttachment',
        'Видеозапись': '__videoAttachment',
        'Аудиозапись': '__audioAttachment',
        'Документ': '__documentAttachment',
        'Опрос': 'poll',
        'Место': '__geoAttacher',
        'Источник': '__sourceAttacher'
    };

    if (map[type]) {
        return triggerOpenVKAttachment(map[type]);
    }

    closeActionSheet();
    return false;
}

/*
 * Удаляем только визуальный badge темы.
 * Настоящее удаление attachment выполняет штатный OpenVK JS.
 */
function clearAttachment() {
    var badge = document.getElementById('attached_badge_container');
    var badgeText = document.getElementById('attached_item_name');

    if (badge) {
        badge.style.display = 'none';
    }

    if (badgeText) {
        badgeText.textContent = '';
    }
}

function clearCommentAttachment() {
    var badge = document.getElementById('comment_attached_badge_container');
    var badgeText = document.getElementById('comment_attached_item_name');

    if (badge) {
        badge.style.display = 'none';
    }

    if (badgeText) {
        badgeText.textContent = '';
    }
}

/* ================================================================
   TOAST — только интерфейс, ничего не отправляет на сервер.
   ================================================================ */
var toastTimer = null;

function hideToast() {
    var t = document.getElementById('toast');
    if (t) {
        t.classList.remove('show');
    }
    clearTimeout(toastTimer);
}

function showToast(text, type, title) {
    var t = document.getElementById('toast');
    var titleEl = document.getElementById('toast_title');
    var textEl = document.getElementById('toast_text');
    if (!t) {
        return;
    }

    if (typeof text === 'object' && text !== null) {
        title = text.title || title;
        type = text.type || type;
        text = text.text || text.message || '';
    }

    t.classList.remove('red', 'green');
    t.classList.add(type === 'red' ? 'red' : 'green');

    if (title) {
        titleEl.textContent = title;
        titleEl.style.display = '';
    } else {
        titleEl.style.display = 'none';
    }

    textEl.textContent = text || '';
    textEl.style.display = text ? '' : 'none';

    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(hideToast, 3500);
}

{* ================================================================
   МЕНЮ ДЕЙСТВИЙ С ЗАПИСЬЮ (кнопка ⋮ на карточке поста).

   Ничего не выдумываем: закрепление/архив используют те же
   ссылки /wall{id}/pin, /wall{id}/archive с csrf-хешем, что и
   классическая вёрстка OpenVK; удаление — тот же роут
   /wall{id}/delete?ajax=1; жалоба — штатная функция reportPost()
   из al_feed.js. Редактирование — настоящий VKAPI (wall.getById,
   wall.edit), после сохранения карточка перерисовывается через
   /iapi/getPostTemplate/{id} — тот же серверный components/post.xml,
   которым запись и так отрисована.
   ================================================================ *}
function closePostActionMenu() {
    document.getElementById('post_actions_overlay').classList.remove('active');
    document.getElementById('post_actions_sheet').classList.remove('active');
}

/* Заготовка под меню действий видео (Раздел «Видеозаписи» дорабатывается отдельно). */
function closeVideoActionMenu() {
    var overlay = document.getElementById('video_actions_overlay');
    var sheet = document.getElementById('video_actions_sheet');
    if (overlay) overlay.classList.remove('active');
    if (sheet) sheet.classList.remove('active');
}

function openPostActionMenu(btn) {
    var list = document.getElementById('post_actions_list');
    list.innerHTML = '';

    var postId = btn.dataset.postId;
    var csrf = btn.dataset.csrf;
    var card = btn.closest('.wall-post, .wall-post-full');

    function addItem(label, handler) {
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = 'javascript:void(0)';
        a.textContent = label;
        a.onclick = handler;
        li.appendChild(a);
        list.appendChild(li);
    }

    if (btn.dataset.canEdit === '1') {
        addItem(tr('edit'), function () {
            closePostActionMenu();
            openPostEditModal(postId, card);
        });
    }

    if (btn.dataset.canPin === '1') {
        var pinning = btn.dataset.isPinned !== '1';
        var pinHref = '/wall' + postId + '/pin?act=' + (pinning ? 'pin' : 'unpin') + '&hash=' + csrf;
        addItem(pinning ? tr('pin') : tr('unpin'), function () {
            closePostActionMenu();
            location.href = pinHref;
        });
    }

    if (btn.dataset.canArchive === '1') {
        var archiving = btn.dataset.isArchived !== '1';
        var archiveHref = '/wall' + postId + '/archive?hash=' + csrf;
        addItem(archiving ? tr('archive_action') : tr('unarchive_action'), function () {
            closePostActionMenu();
            location.href = archiveHref;
        });
    }

    if (btn.dataset.canDelete === '1') {
        addItem(tr('delete'), function () {
            closePostActionMenu();
            deletePostConfirmed(postId, card);
        });
    } else if (btn.dataset.canReport === '1') {
        addItem(tr('report'), function () {
            closePostActionMenu();
            if (typeof reportPost === 'function') {
                reportPost(parseInt(postId.split('_')[1] || postId, 10));
            }
        });
    }

    if (!list.children.length) {
        return false;
    }

    document.getElementById('post_actions_overlay').classList.add('active');
    document.getElementById('post_actions_sheet').classList.add('active');
    return false;
}

function deletePostConfirmed(postId, card) {
    if (typeof MessageBox === 'function') {
        MessageBox(tr('warning'), tr('question_confirm'), [tr('yes'), tr('no')], [
            function () { performPostDelete(postId, card); },
            Function.noop
        ]);
    } else if (window.confirm(tr('question_confirm'))) {
        performPostDelete(postId, card);
    }
}

async function performPostDelete(postId, card) {
    try {
        var res = await fetch('/wall' + postId + '/delete?ajax=1', { method: 'POST' });
        var data = await res.json();
        if (data.success) {
            if (card) {
                card.remove();
            }
        } else if (data.flash && data.flash.message) {
            showToast(data.flash.message, 'red');
        }
    } catch (e) {
        showToast(tr('error'), 'red');
    }
}

var currentEditPostId = null;
var currentEditCard = null;

async function openPostEditModal(postId, card) {
    currentEditPostId = postId;
    currentEditCard = card;

    var ta = document.getElementById('post_edit_textarea');
    ta.value = '';
    document.getElementById('post_edit_overlay').classList.add('active');

    try {
        var res = await window.OVKAPI.call('wall.getById', { posts: postId });
        if (res && res[0]) {
            ta.value = res[0].text || '';
        }
    } catch (e) {
        showToast(e.message || tr('error'), 'red');
    }

    ta.focus();
}

function closePostEditModal() {
    document.getElementById('post_edit_overlay').classList.remove('active');
    currentEditPostId = null;
    currentEditCard = null;
}

{* ================================================================
   СМЕНА СТАТУСА. Настоящий маршрут: POST /edit?act=status
   (status, broadcast) -> JSON {success:true}. Cм. UserPresenter::renderEdit.
   ================================================================ *}
function openStatusEditor(currentStatus) {
    document.getElementById('status_edit_input').value = currentStatus || '';
    document.getElementById('status_edit_overlay').classList.add('active');
    document.getElementById('status_edit_input').focus();
}

function closeStatusEditor() {
    document.getElementById('status_edit_overlay').classList.remove('active');
}

async function saveStatusEdit() {
    var input = document.getElementById('status_edit_input');
    var text = input.value;
    var saveBtn = document.getElementById('status_edit_save');
    saveBtn.disabled = true;

    try {
        var form = new FormData();
        form.append('status', text);

        var res = await fetch('/edit?act=status', { method: 'POST', body: form });
        var data = await res.json();

        if (data.success) {
            var display = document.getElementById('page_status_text');
            if (display) {
                display.textContent = text;
            }
            var trigger = document.getElementById('profile_status_display');
            if (trigger) {
                trigger.dataset.currentStatus = text;
            }
            closeStatusEditor();
        } else if (data.flash && data.flash.message) {
            showToast(data.flash.message, 'red');
        }
    } catch (e) {
        showToast(tr('error'), 'red');
    } finally {
        saveBtn.disabled = false;
    }
}

async function savePostEdit() {
    if (!currentEditPostId) {
        return;
    }

    var ta = document.getElementById('post_edit_textarea');
    var text = ta.value.trim();
    if (!text) {
        showToast(tr('error'), 'red');
        return;
    }

    var parts = currentEditPostId.split('_');
    var saveBtn = document.getElementById('post_edit_save');
    saveBtn.disabled = true;

    try {
        await window.OVKAPI.call('wall.edit', {
            owner_id: parts[0],
            post_id: parts[1],
            message: text
        });

        var html = await (await fetch('/iapi/getPostTemplate/' + currentEditPostId + '?type=post&from_page=another', {
            method: 'POST'
        })).text();

        if (currentEditCard && html.trim()) {
            var wrap = document.createElement('div');
            wrap.innerHTML = html.trim();
            if (wrap.firstElementChild) {
                currentEditCard.replaceWith(wrap.firstElementChild);
            }
        }

        closePostEditModal();
    } catch (e) {
        showToast(e.message || tr('error'), 'red');
    } finally {
        saveBtn.disabled = false;
    }
}

/*
 * Вкладки: активная вкладка прокручивается в видимую область,
 * если ряд вкладок шире экрана (мобильные, настройки: 6 вкладок).
 * Ничего не меняет в разметке и ссылках.
 */
(function () {
    function reveal() {
        var bars = document.querySelectorAll('.tabs, .tabs-bar');
        Array.prototype.forEach.call(bars, function (bar) {
            if (bar.scrollWidth <= bar.clientWidth) return;
            var act = bar.querySelector('#activetabs, #active, .tab-item.selected');
            if (!act) return;
            var target = act.offsetLeft - (bar.clientWidth - act.offsetWidth) / 2;
            bar.scrollLeft = Math.max(0, target);
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', reveal);
    } else {
        reveal();
    }
})();
</script>
<script>
(function() {
    function relocatePlayer() {
        var player = document.getElementById('ajax_audio_player');
        var slot = document.getElementById('sidebar_audio_player_slot');
        var isDesktop = window.innerWidth >= 561;

        if (!player) return;

        if (isDesktop && slot) {
            if (player.parentNode !== slot) {
                slot.appendChild(player);
            }
        } else {
            if (player.parentNode !== document.body) {
                document.body.appendChild(player);
            }
        }
    }

    var observer = new MutationObserver(function(mutations) {
        relocatePlayer();
    });

    observer.observe(document.body, { childList: true, subtree: true });

    window.addEventListener('resize', relocatePlayer);
    document.addEventListener('DOMContentLoaded', relocatePlayer);
})();
</script>
