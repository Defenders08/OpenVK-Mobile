{*  =========================================================
    WALL — страница стены пользователя или сообщества (/wall{id}).

    Переменные от WallPresenter:
      $owner         — ID владельца (отрицательный у сообществ);
      $oObj          — сам владелец (User или Club);
      $club          — сообщество, если стена групповая;
      $type          — вкладка: all | owners | others | archive | search;
      $canPost       — можно ли писать;
      $posts         — записи страницы;
      $count         — всего записей;
      $paginatorConf — настройки пагинатора;
      $archiveYears, $archiveYear — годы для архива.

    Вкладки — обычные ссылки с GET-параметром ?type=.
    Форма поиска по стене — настоящий GET с полем q.
    Формы управления архивом — настоящие POST на
    /wall{owner}/archive/manage с полями hash, action, year.
    ========================================================= *}

{extends "../@layout.xml"}

{block title}{_wall}{/block}

{block header}
    <a href="{$oObj->getURL()}">{$oObj->getCanonicalName()}</a> &raquo; {_wall}
    <span>{tr("wall", $count)}</span>
{/block}

{block content}

    {* ---------- ВКЛАДКИ ----------
       id="activetabs" / "act_tab_a" — маркеры активной вкладки,
       их же ожидают остальные страницы OpenVK. *}
    <div class="tabs">
        <div n:attr="id => ($type != 'all' ? null : 'activetabs')" class="tab">
            <a n:attr="id => ($type != 'all' ? null : 'act_tab_a')" href="/wall{$owner}">{_all_posts}</a>
        </div>
        <div n:attr="id => ($type != 'owners' ? null : 'activetabs')" class="tab">
            <a n:attr="id => ($type != 'owners' ? null : 'act_tab_a')" href="/wall{$owner}?type=owners">
                {isset($club) ? tr("clubs_posts") : tr("users_posts", ovk_proc_strtr($oObj->getFirstName(), 20))}
            </a>
        </div>
        <div n:attr="id => ($type != 'others' ? null : 'activetabs')" class="tab">
            <a n:attr="id => ($type != 'others' ? null : 'act_tab_a')" href="/wall{$owner}?type=others">{_others_posts}</a>
        </div>
        <div n:if="(isset($thisUser) && $owner > 0 && $thisUser->getId() === $oObj->getId()) || (isset($thisUser) && $owner < 0 && $club->canBeModifiedBy($thisUser))"
             n:attr="id => ($type != 'archive' ? null : 'activetabs')" class="tab">
            <a n:attr="id => ($type != 'archive' ? null : 'act_tab_a')" href="/wall{$owner}?type=archive">{_archived_posts}</a>
        </div>
        <div n:attr="id => ($type != 'search' ? null : 'activetabs')" class="tab">
            <a n:attr="id => ($type != 'search' ? null : 'act_tab_a')" href="/wall{$owner}?type=search">{_header_search}</a>
        </div>
        <a href="/wall{$owner}/rss">{_read_in_rss}</a>
    </div>

    {* ---------- ФОРМА НОВОЙ ЗАПИСИ ---------- *}
    <div n:if="$canPost && $type == 'all'" class="wall-form">
        {include "../components/textArea.xml", route => "/wall$owner/makePost",
                 graffiti => true, polls => true, notes => true, hasSource => true, geo => true}
    </div>

    {* ---------- ПОИСК ПО СТЕНЕ ---------- *}
    <form n:if="$type == 'search'" class="form wall_search"
          action="/wall{$owner}?type=search" method="get" enctype="multipart/form-data">
        <input class="form-input" type="text" name="q" autocomplete="off" value="{$_GET['q']}" />
        <input type="submit" value="{_header_search}" class="button" />
    </form>

    {* ---------- АРХИВ ---------- *}
    <div n:if="$type == 'archive'" class="message archive_banner">
        <b>{_archive_banner_title}</b>
        <p>{_archive_banner_desc}</p>
    </div>

    {var $currentArchiveYear = $archiveYear ?? ($archiveYears[0] ?? NULL)}

    <div n:if="$type == 'archive' && sizeof($archiveYears) > 0"
         class="archive_manager"
         data-archive-manager
         data-all-years-mode="{is_null($archiveYear) ? '1' : '0'}">

        {* Фильтр по годам — обычные ссылки. *}
        <div class="archive_years">
            <a n:class="archive_all_years, is_filter_active => is_null($archiveYear)"
               href="/wall{$owner}?type=archive">{_archive_all_years}</a>

            <a n:foreach="$archiveYears as $yearIndex => $year" n:if="$yearIndex < 6"
               n:class="archive_year, is_current => $year === $currentArchiveYear"
               data-archive-year-link="{$year}"
               href="/wall{$owner}?type=archive&year={$year}">{$year}</a>

            {*  «Ещё» — раскрывается через <details>, без JavaScript. *}
            <details n:if="sizeof($archiveYears) > 6" class="archive_more_years">
                <summary data-default-label="{_archive_more}"
                         data-year-template="{tr('archive_more_year', '__YEAR__')}">{_archive_more}</summary>
                <div class="archive_more_years_menu">
                    <a n:foreach="$archiveYears as $yearIndex => $year" n:if="$yearIndex >= 6"
                       n:class="archive_year, is_current => $year === $currentArchiveYear"
                       data-archive-year-link="{$year}"
                       href="/wall{$owner}?type=archive&year={$year}">{$year}</a>
                </div>
            </details>
        </div>

        {*  Массовые действия над архивом.
            Это НАСТОЯЩИЕ POST-формы. Поля hash (CSRF), action и
            year обязательны. data-archive-year-input читает
            скрипт внизу страницы. *}
        <details class="archive_actions">
            <summary>{_actions}</summary>
            <div class="archive_actions_menu">

                <form method="post" action="/wall{$owner}/archive/manage">
                    <input type="hidden" name="hash" value="{$csrfToken}">
                    <input type="hidden" name="action" value="archive_year">
                    <input type="hidden" name="year" value="{$currentArchiveYear}" data-archive-year-input>
                    <button type="submit" class="button"
                            data-archive-year-template="{tr('archive_all_posts_from_year', '__YEAR__')}"
                            data-confirm="{tr('archive_confirm_year', $currentArchiveYear)}"
                            data-confirm-template="{tr('archive_confirm_year', '__YEAR__')}"
                            onclick="return confirm(this.dataset.confirm)">{tr("archive_all_posts_from_year", $currentArchiveYear)}</button>
                </form>

                <form method="post" action="/wall{$owner}/archive/manage">
                    <input type="hidden" name="hash" value="{$csrfToken}">
                    <input type="hidden" name="action" value="restore_year">
                    <input type="hidden" name="year" value="{$currentArchiveYear}" data-archive-year-input>
                    <button type="submit" class="button"
                            data-archive-year-template="{tr('restore_all_posts_from_year', '__YEAR__')}"
                            data-confirm="{tr('restore_confirm_year', $currentArchiveYear)}"
                            data-confirm-template="{tr('restore_confirm_year', '__YEAR__')}"
                            onclick="return confirm(this.dataset.confirm)">{tr("restore_all_posts_from_year", $currentArchiveYear)}</button>
                </form>

                <form method="post" action="/wall{$owner}/archive/manage">
                    <input type="hidden" name="hash" value="{$csrfToken}">
                    <input type="hidden" name="action" value="archive_all">
                    <button type="submit" class="button" data-confirm="{_archive_confirm_all}"
                            onclick="return confirm(this.dataset.confirm)">{_archive_all_posts}</button>
                </form>

            </div>
        </details>
    </div>

    {* ---------- СПИСОК ЗАПИСЕЙ ---------- *}
    <div class="wall-posts content scroll_container">
        {if sizeof($posts) > 0}
            <div class="scroll_node archive_post_node" n:foreach="$posts as $post"
                 data-uniqueid="{$post->getPrettyId()}"
                 n:attr="data-archive-year => $type == 'archive' ? $post->getPublicationTime()->format('%Y') : NULL">
                <a name="postGarter={$post->getId()}"></a>
                {include "../components/post.xml", post => $post, commentSection => true}
            </div>

            {include "../components/paginator.xml", conf => $paginatorConf}
        {elseif $type != "search"}
            <div class="empty-state-block"><span class="empty-state-text">{_no_posts_abstract}</span></div>
        {else}
            <div class="empty-state-block"><span class="empty-state-text">{_no_found}</span></div>
        {/if}
    </div>

    {*  ---------------------------------------------------------
        СКРИПТЫ СТРАНИЦЫ — перенесены из оригинала БЕЗ ИЗМЕНЕНИЙ.

        Это не оформление, а функциональность:
          1) подсветка найденного текста при поиске по стене
             (использует штатную функцию highlightText);
          2) менеджер архива: при прокрутке он подставляет
             текущий год в СКРЫТЫЕ ПОЛЯ настоящих POST-форм
             выше (data-archive-year-input). Без него массовые
             действия применялись бы не к тому году.

        Селектор '.content' в первом скрипте — причина, по
        которой класс `content` оставлен на списке записей.
        --------------------------------------------------------- *}
        <script n:if='$type == "search" && sizeof($posts) > 0 && !empty($_GET["q"])'>
            function __scrollHook(page) {
                highlightText({$_GET["q"]}, '.content', ['.text'])
            }

            __scrollHook()
        </script>

        <script n:if="$type == 'archive' && sizeof($archiveYears) > 0">
            (function() {
                const manager = document.querySelector('[data-archive-manager]')
                if (!manager) {
                    return
                }

                const allYearsMode = manager.dataset.allYearsMode === '1'
                let scheduled = false

                function applyCurrentYear(year) {
                    if (!year) {
                        return
                    }

                    year = String(year)

                    manager.dataset.currentYear = year
                    manager.querySelectorAll('[data-archive-year-link]').forEach(link => {
                        link.classList.toggle('is_current', link.dataset.archiveYearLink === year)
                    })
                    manager.querySelectorAll('[data-archive-year-input]').forEach(input => {
                        input.value = year
                    })
                    manager.querySelectorAll('[data-archive-year-template]').forEach(button => {
                        button.textContent = button.dataset.archiveYearTemplate.replace('__YEAR__', year)
                        button.dataset.confirm = button.dataset.confirmTemplate.replace('__YEAR__', year)
                    })

                    const more = manager.querySelector('.archive_more_years')
                    if (more) {
                        const summary = more.querySelector('summary')
                        const currentInMore = more.querySelector('[data-archive-year-link="' + year + '"]')
                        summary.textContent = currentInMore
                            ? summary.dataset.yearTemplate.replace('__YEAR__', year)
                            : summary.dataset.defaultLabel
                    }
                }

                function updateYearFromScroll() {
                    scheduled = false
                    if (!allYearsMode) {
                        return
                    }

                    const posts = Array.from(document.querySelectorAll('.archive_post_node[data-archive-year]'))
                    if (posts.length === 0) {
                        return
                    }

                    const referenceLine = manager.getBoundingClientRect().bottom + 96
                    let currentPost = posts[0]
                    for (const post of posts) {
                        if (post.getBoundingClientRect().top <= referenceLine) {
                            currentPost = post
                        } else {
                            break
                        }
                    }

                    const reachedBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4
                    if (reachedBottom) {
                        currentPost = posts[posts.length - 1]
                    }

                    applyCurrentYear(currentPost.dataset.archiveYear)
                }

                function scheduleYearUpdate() {
                    if (scheduled) {
                        return
                    }

                    scheduled = true
                    requestAnimationFrame(updateYearFromScroll)
                }

                const previousScrollHook = window.__scrollHook
                window.__scrollHook = function(page) {
                    if (typeof previousScrollHook === 'function') {
                        previousScrollHook(page)
                    }
                    scheduleYearUpdate()
                }

                window.addEventListener('scroll', scheduleYearUpdate, { passive: true })
                window.addEventListener('archive:changed', scheduleYearUpdate)
                applyCurrentYear({$currentArchiveYear})
                scheduleYearUpdate()
            })()
        </script>
{/block}
