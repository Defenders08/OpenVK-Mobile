{syntax off}

<script>
(function () {
    "use strict";

    /*
     * =========================================================
     * FEED SETTINGS
     * =========================================================
     */

    var feedSettingsOpened = false;
    var feedSettingsOverlay = null;


    /*
     * Экранирование текста перед вставкой в HTML.
     */
    function escapeHtml(value) {

        return String(value == null ? "" : value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    /*
     * Закрытие окна.
     */
    function closeFeedSettings() {

        if (!feedSettingsOverlay)
            return;

        feedSettingsOverlay.classList.remove("visible");

        setTimeout(function () {

            if (feedSettingsOverlay &&
                feedSettingsOverlay.parentNode) {

                feedSettingsOverlay.parentNode.removeChild(
                    feedSettingsOverlay
                );

            }

            feedSettingsOverlay = null;
            feedSettingsOpened = false;

        }, 150);

    }


    /*
     * Создание URL с настройками.
     */
    function applyFeedSettings(modal) {

        var url = new URL(
            window.location.href
        );


        /*
         * Количество записей.
         */
        var postsSelect =
            modal.querySelector("#vkFeedPosts");

        if (postsSelect) {

            url.searchParams.set(
                "posts",
                postsSelect.value
            );

        }


        /*
         * Страница.
         */
        var pageInput =
            modal.querySelector("#vkFeedPage");

        var pagesCount =
            Number(
                modal.dataset.pagescount || 1
            );

        var page =
            Number(
                pageInput ? pageInput.value : 1
            );

        if (!page || page < 1)
            page = 1;

        if (pagesCount > 0 && page > pagesCount)
            page = pagesCount;

        url.searchParams.set(
            "p",
            page
        );


        /*
         * Показывать игнорируемые источники.
         */
        var ignored =
            modal.querySelector("#vkFeedIgnored");

        if (ignored && ignored.checked) {

            url.searchParams.set(
                "return_banned",
                "1"
            );

        } else {

            url.searchParams.delete(
                "return_banned"
            );

        }


        /*
         * Записи со стен других пользователей.
         */
        var alien =
            modal.querySelector("#vkFeedAlien");

        if (alien && alien.checked) {

            url.searchParams.set(
                "with_alien_wall_posts",
                "1"
            );

        } else {

            url.searchParams.delete(
                "with_alien_wall_posts"
            );

        }


        /*
         * Переходим на новую страницу.
         */
        window.location.href = url.href;

    }


    /*
     * Загрузка игнорируемых источников.
     *
     * Используем штатный OpenVK API.
     */
    function loadIgnoredSources(container) {

        if (!container)
            return;

        if (container.dataset.loaded === "1")
            return;

        container.dataset.loaded = "1";

        container.innerHTML =
            '<div class="vk-feed-ignored-loading">' +
                'Загрузка...' +
            '</div>';


        fetch(
            "/method/newsfeed.getBanned" +
            "?auth_mechanism=roaming" +
            "&extended=1" +
            "&fields=real_id,screen_name,photo_50" +
            "&merge=1",
            {
                credentials: "same-origin"
            }
        )
        .then(function (response) {

            return response.json();

        })
        .then(function (data) {

            /*
             * Разные версии OpenVK могут отдавать
             * response немного по-разному.
             */
            var response =
                data && data.response
                    ? data.response
                    : null;

            var items =
                response && Array.isArray(response.items)
                    ? response.items
                    : [];


            if (!items.length) {

                container.innerHTML =
                    '<div class="vk-feed-empty">' +
                        'Нет игнорируемых источников.' +
                    '</div>';

                return;

            }


            container.innerHTML = "";


            items.forEach(function (item) {

                var id =
                    item.real_id ||
                    item.id ||
                    0;

                var name =
                    item.name ||
                    (
                        (item.first_name || "") +
                        " " +
                        (item.last_name || "")
                    ).trim();

                if (!name)
                    name = "Пользователь";


                var screenName =
                    item.screen_name || "";


                var row =
                    document.createElement("div");

                row.className =
                    "vk-feed-ignored-item";


                var avatar =
                    item.photo_50 ||
                    item.photo ||
                    "";


                row.innerHTML =

                    '<a class="vk-feed-ignored-avatar" ' +
                       'href="/' +
                       escapeHtml(screenName) +
                    '">' +

                        (
                            avatar
                                ? '<img src="' +
                                    escapeHtml(avatar) +
                                  '">'
                                : '<span class="vk-feed-avatar-placeholder"></span>'
                        ) +

                    '</a>' +


                    '<a class="vk-feed-ignored-name" ' +
                       'href="/' +
                       escapeHtml(screenName) +
                    '">' +

                        escapeHtml(name) +

                    '</a>' +


                    '<button type="button" ' +
                            'class="vk-feed-unignore-button" ' +
                            'data-id="' +
                            escapeHtml(id) +
                            '">' +

                        'Убрать' +

                    '</button>';


                container.appendChild(row);

            });

        })
        .catch(function () {

            container.innerHTML =
                '<div class="vk-feed-empty">' +
                    'Не удалось загрузить список.' +
                '</div>';

        });

    }


    /*
     * Открытие окна настроек.
     */
    function openFeedSettings(link) {

        if (feedSettingsOpened)
            return;

        feedSettingsOpened = true;


        var currentUrl =
            new URL(window.location.href);


        var pagesCount =
            Number(
                link.dataset.pagescount || 1
            );


        var currentPosts =
            Number(
                currentUrl.searchParams.get("posts") || 10
            );


        var currentPage =
            Number(
                currentUrl.searchParams.get("p") || 1
            );


        var currentIgnored =
            currentUrl.searchParams.get(
                "return_banned"
            ) === "1";


        var currentAlien =
            currentUrl.searchParams.get(
                "with_alien_wall_posts"
            ) === "1";


        /*
         * Overlay.
         */
        var overlay =
            document.createElement("div");

        overlay.className =
            "vk-feed-settings-overlay";


        /*
         * Modal.
         *
         * Переиспользует существующий компонент модалки темы
         * (.modal-box/.modal-head/.modal-body/.modal-foot — см.
         * #status_edit_overlay/#post_edit_overlay в @layout.xml),
         * а не отдельный дизайн. Функциональные классы/id для JS
         * (.vk-feed-settings-close/-tab/-main/-ignored,
         * .vk-feed-button-cancel/-primary, #vkFeed*) не переименованы —
         * рядом просто добавлены настоящие визуальные классы темы.
         */
        var modal =
            document.createElement("div");

        modal.className =
            "modal-box vk-feed-settings-modal";

        modal.dataset.pagescount =
            pagesCount;


        modal.innerHTML =

            '<div class="modal-head vk-feed-settings-header">' +

                '<b>Настройки ленты</b>' +

                '<span class="vk-feed-settings-close" ' +
                      'title="Закрыть">' +
                    '×' +
                '</span>' +

            '</div>' +


            '<div class="tabs-bar vk-feed-settings-tabs">' +

                '<div class="tab-item selected vk-feed-settings-tab" ' +
                     'data-tab="main">' +

                    'Основные' +

                '</div>' +

                '<div class="tab-item vk-feed-settings-tab" ' +
                     'data-tab="ignored">' +

                    'Игнорируемые источники' +

                '</div>' +

            '</div>' +


            '<div class="modal-body vk-feed-settings-content">' +


                '<div class="vk-feed-settings-main">' +

                    '<div class="vk-feed-setting">' +

                        '<label for="vkFeedPosts">' +
                            'Записей на странице' +
                        '</label>' +

                        '<select id="vkFeedPosts" ' +
                                'class="form-input vk-feed-select">' +

                            '<option value="1">1</option>' +
                            '<option value="5">5</option>' +
                            '<option value="10">10</option>' +
                            '<option value="20">20</option>' +
                            '<option value="30">30</option>' +
                            '<option value="40">40</option>' +
                            '<option value="50">50</option>' +

                        '</select>' +

                    '</div>' +


                    '<div class="vk-feed-setting">' +

                        '<label for="vkFeedPage">' +
                            'Начать со страницы' +
                        '</label>' +

                        '<input type="number" ' +
                               'id="vkFeedPage" ' +
                               'class="form-input vk-feed-input" ' +
                               'min="1" ' +
                               'max="' +
                               pagesCount +
                               '" ' +
                               'value="' +
                               currentPage +
                               '">' +

                    '</div>' +


                    '<label class="vk-feed-checkbox">' +

                        '<input type="checkbox" ' +
                               'id="vkFeedIgnored" ' +
                               (
                                   currentIgnored
                                       ? "checked"
                                       : ""
                               ) +
                               '>' +

                        '<span>' +
                            'Показывать записи игнорируемых источников' +
                        '</span>' +

                    '</label>' +


                    '<label class="vk-feed-checkbox">' +

                        '<input type="checkbox" ' +
                               'id="vkFeedAlien" ' +
                               (
                                   currentAlien
                                       ? "checked"
                                       : ""
                               ) +
                               '>' +

                        '<span>' +
                            'Показывать записи со стен других пользователей' +
                        '</span>' +

                    '</label>' +

                '</div>' +


                '<div class="vk-feed-settings-ignored" ' +
                     'style="display:none;">' +

                    '<div class="vk-feed-ignored-loading">' +
                        'Загрузка...' +
                    '</div>' +

                '</div>' +


            '</div>' +


            '<div class="modal-foot vk-feed-settings-footer">' +

                '<button type="button" ' +
                        'class="btn-vk secondary vk-feed-button vk-feed-button-cancel">' +

                    'Отмена' +

                '</button>' +


                '<button type="button" ' +
                        'class="btn-vk vk-feed-button vk-feed-button-primary">' +

                    'Применить' +

                '</button>' +

            '</div>';


        overlay.appendChild(modal);
        document.body.appendChild(overlay);

        feedSettingsOverlay = overlay;


        /*
         * Выставляем текущее количество постов.
         */
        var postsSelect =
            modal.querySelector("#vkFeedPosts");


        if (postsSelect) {

            var postOption =
                postsSelect.querySelector(
                    'option[value="' +
                    currentPosts +
                    '"]'
                );

            if (postOption) {

                postOption.selected = true;

            } else {

                postsSelect.value = "10";

            }

        }


        /*
         * Закрытие.
         */
        modal.querySelector(
            ".vk-feed-settings-close"
        ).addEventListener(
            "click",
            closeFeedSettings
        );


        modal.querySelector(
            ".vk-feed-button-cancel"
        ).addEventListener(
            "click",
            closeFeedSettings
        );


        overlay.addEventListener(
            "click",
            function (event) {

                if (event.target === overlay)
                    closeFeedSettings();

            }
        );


        /*
         * Применение.
         */
        modal.querySelector(
            ".vk-feed-button-primary"
        ).addEventListener(
            "click",
            function () {

                applyFeedSettings(modal);

            }
        );


        /*
         * Вкладки.
         */
        modal.querySelectorAll(
            ".vk-feed-settings-tab"
        ).forEach(function (tab) {

            tab.addEventListener(
                "click",
                function () {

                    modal.querySelectorAll(
                        ".vk-feed-settings-tab"
                    ).forEach(function (item) {

                        item.classList.remove(
                            "selected"
                        );

                    });


                    tab.classList.add("selected");


                    var main =
                        modal.querySelector(
                            ".vk-feed-settings-main"
                        );

                    var ignored =
                        modal.querySelector(
                            ".vk-feed-settings-ignored"
                        );


                    if (tab.dataset.tab === "main") {

                        main.style.display = "";
                        ignored.style.display = "none";

                    } else {

                        main.style.display = "none";
                        ignored.style.display = "";

                        loadIgnoredSources(
                            ignored
                        );

                    }

                }
            );

        });


        /*
         * Кнопка "Убрать" в списке игнорируемых источников.
         * Настоящий VKAPI: newsfeed.deleteBan (user_ids/group_ids).
         */
        modal.addEventListener("click", function (event) {

            var button = event.target.closest(
                ".vk-feed-unignore-button"
            );

            if (!button)
                return;

            var id = parseInt(button.dataset.id, 10);

            if (!id)
                return;

            button.disabled = true;

            var params = id > 0
                ? { user_ids: String(id) }
                : { group_ids: String(Math.abs(id)) };

            window.OVKAPI.call("newsfeed.deleteBan", params)
                .then(function () {

                    var row = button.closest(".vk-feed-ignored-item");

                    if (row)
                        row.remove();

                })
                .catch(function (e) {

                    button.disabled = false;

                    if (typeof showToast === "function")
                        showToast(e.message || "Ошибка", "red");

                });

        });


        /*
         * ESC.
         */
        function escapeHandler(event) {

            if (event.key === "Escape") {

                closeFeedSettings();

                document.removeEventListener(
                    "keydown",
                    escapeHandler
                );

            }

        }

        document.addEventListener(
            "keydown",
            escapeHandler
        );


        /*
         * Плавное появление.
         */
        requestAnimationFrame(function () {

            overlay.classList.add(
                "visible"
            );

        });

    }


    /*
     * =========================================================
     * COMPOSER
     * =========================================================
     */

    window.OvkWallComposer = {

        getWrite: function (element) {

            if (!element)
                return null;

            return element.id === "write"
                ? element
                : element.closest(
                    "#write, .wall-form, .ovk-post-form"
                );

        },


        showButtons: function (write) {

            if (!write)
                return;

            var buttons =
                write.querySelector(
                    ".post-buttons"
                );

            if (buttons)
                buttons.style.display = "block";

        },


        toggleMenu: function (write) {

            if (!write)
                return;

            var menu =
                write.querySelector(
                    ".ovk-wall-attachment-menu"
                );

            if (menu)
                menu.classList.toggle(
                    "hidden"
                );

        },


        closeMenu: function (write) {

            if (!write)
                return;

            var menu =
                write.querySelector(
                    ".ovk-wall-attachment-menu"
                );

            if (menu)
                menu.classList.add(
                    "hidden"
                );

        },


        triggerUpload: function (
            event,
            button,
            type
        ) {

            if (event) {

                event.preventDefault();
                event.stopPropagation();

            }


            var write =
                this.getWrite(button);

            if (!write)
                return;


            this.closeMenu(write);
            this.showButtons(write);

            this.choosePhotoNative(write);

        },


        choosePhotoNative: function (write) {

            var self = this;

            var form =
                write.querySelector("form") ||
                write;


            var horizontal =
                form.querySelector(
                    ".post-horizontal"
                );


            if (!horizontal) {

                horizontal =
                    document.querySelector(
                        "#write .post-horizontal"
                    );

            }


            var input =
                document.createElement("input");


            input.type = "file";
            input.accept = "image/*";
            input.name = "photo[]";
            input.multiple = true;
            input.style.display = "none";


            document.body.appendChild(input);


            input.addEventListener(
                "change",
                function () {

                    var files =
                        Array.from(
                            input.files || []
                        );


                    input.remove();


                    if (!files.length)
                        return;


                    var contextId =
                        write.dataset.id ||
                        document.getElementById(
                            "write"
                        ).dataset.id;


                    var formData =
                        new FormData();


                    for (
                        var i = 0;
                        i < files.length;
                        i++
                    ) {

                        formData.append(
                            "photo_" + i,
                            files[i]
                        );

                    }


                    formData.append(
                        "count",
                        files.length
                    );


                    var csrfMeta =
                        document.querySelector(
                            'meta[name="csrf"]'
                        );


                    var csrf =
                        (
                            csrfMeta
                                ? (
                                    csrfMeta.content ||
                                    csrfMeta.getAttribute("value")
                                )
                                : ""
                        ) ||
                        (
                            form.querySelector(
                                'input[name="hash"]'
                            ) || {}
                        ).value;


                    formData.append(
                        "hash",
                        csrf
                    );


                    var temporary =
                        document.createElement("div");


                    temporary.className =
                        "attachment-item upload-item lagged";


                    temporary.innerHTML =
                        '<div style="' +
                            'width:64px;' +
                            'height:64px;' +
                            'background:var(--color-background-secondary);' +
                            'display:flex;' +
                            'align-items:center;' +
                            'justify-content:center;' +
                            'font-size:10px;' +
                            'color:var(--color-text-tertiary);' +
                        '">' +
                            'Загрузка...' +
                        '</div>';


                    if (horizontal)
                        horizontal.appendChild(
                            temporary
                        );


                    fetch(
                        "/photos/upload?upload_context=" +
                        encodeURIComponent(contextId),
                        {
                            method: "POST",
                            body: formData,
                            credentials: "same-origin"
                        }
                    )
                    .then(function (response) {

                        return response.json();

                    })
                    .then(function (response) {

                        if (temporary.parentNode)
                            temporary.remove();


                        if (
                            response.success &&
                            response.photos
                        ) {

                            var hiddenHoriz =
                                form.querySelector(
                                    'input[name="horizontal_attachments"]'
                                );


                            var hiddenAttach =
                                form.querySelector(
                                    'input[name="attachments"]'
                                );


                            if (!hiddenAttach) {

                                hiddenAttach =
                                    document.createElement(
                                        "input"
                                    );

                                hiddenAttach.type =
                                    "hidden";

                                hiddenAttach.name =
                                    "attachments";

                                hiddenAttach.value =
                                    "";

                                form.appendChild(
                                    hiddenAttach
                                );

                            }


                            response.photos.forEach(
                                function (photo) {

                                    var descriptor =
                                        photo.target ||
                                        (
                                            "photo" +
                                            (
                                                photo.pretty_id ||
                                                photo.id
                                            )
                                        );


                                    if (hiddenHoriz) {

                                        var horizontalList =
                                            hiddenHoriz.value
                                                ? hiddenHoriz.value
                                                    .split(",")
                                                    .filter(Boolean)
                                                : [];


                                        if (
                                            horizontalList.indexOf(
                                                descriptor
                                            ) === -1 &&
                                            horizontalList.indexOf(
                                                String(
                                                    photo.pretty_id
                                                )
                                            ) === -1
                                        ) {

                                            horizontalList.push(
                                                descriptor
                                            );

                                        }


                                        hiddenHoriz.value =
                                            horizontalList.join(
                                                ","
                                            );

                                    }


                                    if (hiddenAttach) {

                                        var attachList =
                                            hiddenAttach.value
                                                ? hiddenAttach.value
                                                    .split(",")
                                                    .filter(Boolean)
                                                : [];


                                        if (
                                            attachList.indexOf(
                                                descriptor
                                            ) === -1
                                        ) {

                                            attachList.push(
                                                descriptor
                                            );

                                        }


                                        hiddenAttach.value =
                                            attachList.join(
                                                ","
                                            );

                                    }


                                    var thumb =
                                        document.createElement(
                                            "div"
                                        );


                                    thumb.className =
                                        "attachment-item upload-item";


                                    thumb.innerHTML =
                                        '<img src="' +
                                        escapeHtml(
                                            photo.url
                                        ) +
                                        '" style="' +
                                            'width:64px;' +
                                            'height:64px;' +
                                            'object-fit:cover;' +
                                            'display:block;' +
                                        '">';


                                    var removeButton =
                                        document.createElement(
                                            "a"
                                        );


                                    removeButton.href =
                                        "javascript:void(0)";

                                    removeButton.className =
                                        "remove-attach";

                                    removeButton.innerHTML =
                                        "&times;";


                                    removeButton.onclick =
                                        function (event) {

                                            event.stopPropagation();

                                            thumb.remove();


                                            if (
                                                hiddenHoriz
                                            ) {

                                                hiddenHoriz.value =
                                                    hiddenHoriz.value
                                                        .split(",")
                                                        .filter(
                                                            function (
                                                                value
                                                            ) {

                                                                return (
                                                                    value !==
                                                                        descriptor &&
                                                                    value !==
                                                                        String(
                                                                            photo.pretty_id
                                                                        )
                                                                );

                                                            }
                                                        )
                                                        .join(",");

                                            }


                                            if (
                                                hiddenAttach
                                            ) {

                                                hiddenAttach.value =
                                                    hiddenAttach.value
                                                        .split(",")
                                                        .filter(
                                                            function (
                                                                value
                                                            ) {

                                                                return (
                                                                    value !==
                                                                    descriptor
                                                                );

                                                            }
                                                        )
                                                        .join(",");

                                            }

                                        };


                                    thumb.appendChild(
                                        removeButton
                                    );


                                    if (horizontal) {

                                        horizontal.appendChild(
                                            thumb
                                        );

                                    }

                                }
                            );


                            self.showButtons(
                                write
                            );

                        }

                    })
                    .catch(function (error) {

                        if (temporary.parentNode)
                            temporary.remove();


                        alert(
                            "Ошибка сети: " +
                            error.message
                        );

                    });

                }
            );


            input.click();

        }

    };


    /*
     * =========================================================
     * ИНИЦИАЛИЗАЦИЯ
     * =========================================================
     */

    function initEvents() {


        /*
         * Настройки ленты.
         *
         * Используем capture, чтобы штатный OpenVK
         * обработчик не открыл второе окно.
         */
        document.addEventListener(
            "click",
            function (event) {

                var settingsLink =
                    event.target.closest(
                        "#__feed_settings_link"
                    );


                if (!settingsLink)
                    return;


                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();


                openFeedSettings(
                    settingsLink
                );

            },
            true
        );


        /*
         * Composer textarea.
         */
        document.querySelectorAll(
            ".ovk-post-form textarea"
        ).forEach(function (textarea) {

            if (textarea.dataset.bound)
                return;

            textarea.dataset.bound = "1";


            var open =
                function () {

                    var write =
                        OvkWallComposer.getWrite(
                            textarea
                        );

                    OvkWallComposer.showButtons(
                        write
                    );

                };


            textarea.addEventListener(
                "focus",
                open
            );

            textarea.addEventListener(
                "click",
                open
            );

            textarea.addEventListener(
                "input",
                open
            );

        });


        /*
         * Attachment menu.
         */
        document.querySelectorAll(
            ".menu_toggler"
        ).forEach(function (button) {

            if (button.dataset.bound)
                return;

            button.dataset.bound = "1";


            button.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();
                    event.stopPropagation();


                    var write =
                        OvkWallComposer.getWrite(
                            button
                        );


                    OvkWallComposer.toggleMenu(
                        write
                    );

                }
            );

        });


        /*
         * Закрытие attachment menu.
         */
        document.addEventListener(
            "click",
            function (event) {

                if (
                    !event.target.closest(
                        ".ovk-wall-attachment-area"
                    )
                ) {

                    document.querySelectorAll(
                        ".ovk-wall-attachment-menu"
                    ).forEach(
                        function (menu) {

                            menu.classList.add(
                                "hidden"
                            );

                        }
                    );

                }

            }
        );

    }


    /*
     * Запускаем после загрузки DOM.
     */
    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initEvents
        );

    } else {

        initEvents();

    }

})();
</script>

<style>

