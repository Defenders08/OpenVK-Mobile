    opacity: 1;

}


/* =========================================================
   TABS — теперь настоящий .tabs-bar/.tab-item темы (_ui.xml),
   без отдельного стиля: markup генерируется с этими классами
   напрямую (см. openFeedSettings() выше), .vk-feed-settings-tabs/
   -tab остались только как функциональные хуки для JS
   (data-tab, переключение .selected), своего вида не имеют.
   ========================================================= */


/* =========================================================
   MODAL CONTENT
   ========================================================= */

.vk-feed-settings-content {

    min-height: 250px;

    max-height: 55vh;

    overflow-y: auto;

}


.vk-feed-settings-main {

    padding: 16px;

}

/* Поля настроек визуально соответствуют форме на странице «Настройки»
   темы (.form-label/.form-input, _ui.xml) — подпись мелким прописным
   текстом над полем, то же поле ввода с той же рамкой/радиусом/фокусом. */
.vk-feed-setting {

