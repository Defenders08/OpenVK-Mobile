    box-sizing: border-box;

}


.vk-feed-settings-overlay.visible {

    opacity: 1;

}


/* .modal-box уже даёт фон/границу/тень/радиус/шрифт — здесь только
   ширина этого конкретного окна (шире стандартных 380px, чтобы
   поместился список игнорируемых источников). */
.vk-feed-settings-modal {

    width: 100%;

    max-width: 520px;

}


/* Заголовок — настоящий .modal-head (см. @layout.xml), просто с
   кнопкой закрытия — под неё .modal-head получил display:flex. */
.vk-feed-settings-close {

