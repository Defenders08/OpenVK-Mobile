.vk-feed-button-primary:hover {

    background: #6488ad;

}


/* =========================================================
   IGNORED SOURCES
   ========================================================= */

.vk-feed-settings-ignored {

    padding: 10px;

}


.vk-feed-ignored-item {

    display: flex;

    align-items: center;

    gap: 9px;

    min-height: 52px;

    padding: 7px 6px;

    border-bottom: 1px solid var(--color-background-secondary);

}


.vk-feed-ignored-avatar {

    flex: 0 0 40px;

}


.vk-feed-ignored-avatar img,
.vk-feed-avatar-placeholder {

    width: 40px;
    height: 40px;

    display: block;

    object-fit: cover;

    border-radius: 3px;

}


.vk-feed-avatar-placeholder {

    background: var(--color-background-secondary);

}


.vk-feed-ignored-name {

    flex: 1;

    color: var(--color-primary-strong);

    font-size: 12.5px;

    font-weight: 600;

    text-decoration: none;

}


.vk-feed-ignored-name:hover {

    text-decoration: underline;

}


.vk-feed-unignore-button {

    height: 26px;

    padding: 0 9px;

    border: 1px solid var(--color-border-input);

    border-radius: 2px;

    background: var(--color-background-secondary);

    color: var(--color-text-secondary);

    font-size: 11px;

    cursor: pointer;

}


.vk-feed-unignore-button:hover {

    background: #e4e8eb;

}


.vk-feed-empty,
.vk-feed-ignored-loading {

    padding: 35px 15px;

    text-align: center;

    color: var(--color-text-tertiary);

    font-size: 12.5px;

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

    .vk-feed-settings-overlay {

        padding: 10px;

        align-items: flex-end;

    }


    .vk-feed-settings-modal {

        max-width: none;

        border-radius: 5px 5px 0 0;

    }


    .vk-feed-settings-content {

        max-height: 65vh;

    }


    .vk-feed-setting {

        display: block;

    }


    .vk-feed-setting > label {

        display: block;

        width: auto;

