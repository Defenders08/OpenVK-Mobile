{extends "../@layout.xml"}

{* =========================================================
FEED — лента новостей (/feed и /feed/all).

Переменные: $posts, $paginatorConf, $globalFeed.

id="__feed_settings_link" и data-pagescount — хук штатного
JS. Не удалять.
========================================================= *}

{block title}{_feed}{/block}
{block header}{_feed}{/block}

{block content}

<div class="tabs">
    <div n:attr="id => (isset($globalFeed) ? null : 'activetabs')" class="tab">
        <a n:attr="id => (isset($globalFeed) ? null : 'act_tab_a')" href="/feed">{_my_news}</a>
    </div>

    <div n:attr="id => (isset($globalFeed) ? 'activetabs' : null)" class="tab">
        <a n:attr="id => (isset($globalFeed) ? 'act_tab_a' : null)" href="/feed/all">{_all_news}</a>
    </div>

    {* ВАЖНО: этот id используется штатным OpenVK JS *}
    <a href="#"
       id="__feed_settings_link"
       data-pagescount="{ceil($paginatorConf->count / $paginatorConf->perPage)}">
        {_feed_settings}
    </a>
</div>


{* =========================================================
   КОМПОЗЕР ЛЕНТЫ
   ========================================================= *}

<div class="wall-form">

    {var $composerOwner = $thisUser->getId()}
    {var $route = "/wall" . $composerOwner . "/makePost"}
    {var $graffiti = (bool) ovkGetQuirk("comments.allow-graffiti")}
    {var $composerClub = NULL}

    {default $textAreaCtr = 10}
    {php $textAreaId = ++$textAreaCtr}

    <div id="write"
         class="model_content_textarea vk-wall-card"
         data-id="{$composerOwner}">

        <form action="{$route}"
              method="post"
              enctype="multipart/form-data"
              class="ovk-post-form">

            <textarea id="wall-post-input{$textAreaId}"
                      placeholder="{_write}"
                      name="text"
                      class="vk-post-textarea"
                      autocomplete="off"></textarea>

            <div style="display:none;"></div>

            <div id="post-buttons{$textAreaId}"
                 class="post-buttons vk-post-actions-panel">

                <div class="post-horizontal"></div>
                <div class="post-vertical"></div>

                <div class="post-has-poll" style="display:none;">
                    {_poll}
                </div>

                <div class="post-has-geo" style="display:none;"></div>
                <div class="post-source" style="display:none;"></div>
                <div class="post-replyto" style="display:none;"></div>

                {var $anonEnabled = \OPENVK_ROOT_CONF['openvk']['preferences']['wall']['anonymousPosting']['enable']}

                <div class="post-opts vk-post-checkboxes"
                     n:if="(!is_null($thisUser) && !is_null($composerClub) && $owner < 0 && $composerClub->canBeModifiedBy($thisUser)) || $anonEnabled">

                    {if !is_null($thisUser) && !is_null($composerClub) && $owner < 0}

                        {if $composerClub->canBeModifiedBy($thisUser)}

                            <script n:syntax="off">
                                function onWallAsGroupClick(el) {
                                    var force = document.getElementById("forceSignOpt");

                                    if (force)
                                        force.style.display = el.checked ? "block" : "none";

                                    var anon = document.getElementById("octoberAnonOpt");

                                    if (anon)
                                        anon.style.display = el.checked ? "none" : "block";
                                }
                            </script>

                            <label n:if="$composerClub->getWallType() == 1">
                                <input type="checkbox"
                                       name="as_group"
                                       onchange="onWallAsGroupClick(this)"
                                       checked />
                                {_post_as_group}
                            </label>

                            <label id="forceSignOpt"
                                   style="display:block;">
                                <input type="checkbox"
                                       name="force_sign" />
                                {_add_signature}
                            </label>

                        {/if}

                    {/if}

                    <label n:if="$anonEnabled"
                           id="octoberAnonOpt">

                        <input type="checkbox"
                               name="anon" />

                        {_as_anonymous}

                    </label>

                </div>


                <input type="hidden"
                       name="horizontal_attachments"
                       value=""
                       autocomplete="off" />

                <input type="hidden"
                       name="vertical_attachments"
                       value=""
                       autocomplete="off" />

                <input type="hidden"
                       name="poll"
                       value="none"
                       autocomplete="off" />

                <input type="hidden"
                       name="source"
                       value="none"
                       autocomplete="off" />

                <input type="hidden"
                       name="geo"
                       value=""
                       autocomplete="off" />

                <input type="hidden"
                       name="reply_to_comment"
                       value=""
                       autocomplete="off" />

                <input type="hidden"
                       name="type"
                       value="1"
                       autocomplete="off" />

                <input type="hidden"
                       name="hash"
                       value="{$csrfToken}"
                       autocomplete="off" />


                <div class="vk-composer-bottom">

                    <div class="vk-bottom-left">

                        <div class="ovk-wall-attachment-area">

                            <a href="javascript:void(0)"
                               class="menu_toggler vk-btn-attach"
                               data-target="wallAttachmentMenu{$textAreaId}">
                                {_attach}
                            </a>

                            <div id="wallAttachmentMenu{$textAreaId}"
                                 class="hidden ovk-wall-attachment-menu vk-styled-menu">

                                <a href="javascript:void(0)"
                                   onclick="OvkWallComposer.triggerUpload(event, this, 'photo');">
                                    {_photo}
                                </a>

                                <a href="javascript:void(0)"
                                   class="ovk-real-attachment"
                                   data-kind="video">
                                    {_video}
                                </a>

                                <a href="javascript:void(0)"
                                   class="ovk-real-attachment"
                                   data-kind="audio">
                                    {_audio}
                                </a>

                                <a href="javascript:void(0)"
                                   class="ovk-real-attachment"
                                   data-kind="document"
                                   {if !is_null($composerClub) && $composerClub->canBeModifiedBy($thisUser)}
                                       data-club="{$composerClub->getRealId()}"
                                   {/if}>
                                    {_document}
                                </a>

                                <a n:if="$graffiti"
                                   href="javascript:void(0)"
                                   onclick="event.preventDefault(); event.stopPropagation(); initGraffiti(event);">
                                    {_graffiti}
                                </a>

                                <a href="javascript:void(0)"
                                   class="ovk-special-attachment"
                                   data-kind="geo">
                                    {_geo_place}
                                </a>

                                <a href="javascript:void(0)"
                                   class="ovk-special-attachment"
                                   data-kind="source">
                                    {_source}
                                </a>

                            </div>

                        </div>


                        <label class="vk-nsfw-inline">

                            <input type="checkbox"
                                   name="nsfw" />

                            <span>{_contains_nsfw}</span>

                        </label>

                    </div>


                    <div class="vk-bottom-right">

                        <input type="submit"
                               value="{_write}"
                               class="vk-btn-submit" />

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>


{* =========================================================
   ПОСТЫ
   ========================================================= *}

<div class="wall-posts scroll_container">

    {if sizeof($posts) > 0}
        <div class="scroll_node"
             n:foreach="$posts as $post"
             data-uniqueid="{$post->getPrettyId()}">

            <a name="postGarter={$post->getId()}"></a>

            {include "../components/post.xml",
                     post => $post,
                     onWallOf => true,
                     commentSection => true,
                     bigWall => true}

        </div>
    {else}
        <div class="empty-state-block"><span class="empty-state-text">{_no_posts_abstract}</span></div>
    {/if}

</div>


{* =========================================================
   ПАГИНАТОР
   ========================================================= *}

<div class="feed-bottom">

    {include "../components/paginator.xml",
             conf => $paginatorConf}

</div>
